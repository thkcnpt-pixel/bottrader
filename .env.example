# ============================================================
# VN STOCK SWING BOT — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env for local development.
# On GitHub Actions, store these as Repository Secrets.
# ============================================================

# 1. Firebase Admin Service Account JSON
# Option A (GitHub Actions / Cloud): Paste the entire minified JSON string
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id",...}'

# Option B (Local dev only): Path to downloaded serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# 2. Google Gemini API Key (Google AI Studio Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
VNSTOCK_PRIMARY_SOURCE=VCI
VNSTOCK_FALLBACK_SOURCE=TCBS
DRY_RUN=false
MAX_BUY_CANDIDATES=3
LOG_LEVEL=INFO
